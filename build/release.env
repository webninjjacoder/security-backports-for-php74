# One release = one Ubuntu base version + the patch series for it + a version suffix.
# The suffix must sort ABOVE the base version and BELOW Ubuntu Pro's "+esmN" builds,
# so `apt` moves to Canonical's package by itself if Ubuntu Pro is attached later
# ("+cve" sorts before "+esm" because "c" < "e").
DISTRO=focal
BASE_VERSION=7.4.3-4ubuntu2.29
SUFFIX=cve2
PATCH_DIR=patches/focal-7.4.3-4ubuntu2.29
PACKAGER="Rizwan Ali <mr.rizvan.ali@gmail.com>"
# RFC 2822 date for the debian/changelog entry; also becomes SOURCE_DATE_EPOCH.
CHANGELOG_DATE="Fri, 23 Oct 2026 01:00:00 +0000"
CHANGELOG_TEXT="SECURITY UPDATE: CVE-2026-109618, CVE-2026-109619 (state corruption via bailout) plus backports of the PHP 7.4 fixes Ubuntu Pro ships in +esm1 to +esm4: CVE-2025-1220, CVE-2025-1735, CVE-2025-6491, CVE-2025-14178, CVE-2025-1218, CVE-2025-14181, CVE-2026-6103, CVE-2026-91765, CVE-2026-91766, CVE-2026-91767, CVE-2026-91768, CVE-2026-91769, CVE-2026-92842, CVE-2026-93682. Not affected in 7.4: CVE-2025-14177, CVE-2025-14180."
