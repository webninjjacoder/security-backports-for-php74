# One release = one Ubuntu base version + the patch series for it + a version suffix.
# The suffix must sort ABOVE the base version and BELOW Ubuntu Pro's "+esmN" builds,
# so `apt` moves to Canonical's package by itself if Ubuntu Pro is attached later
# ("+cve" sorts before "+esm" because "c" < "e").
DISTRO=focal
BASE_VERSION=7.4.3-4ubuntu2.29
SUFFIX=cve1
PATCH_DIR=patches/focal-7.4.3-4ubuntu2.29
PACKAGER="Rizwan Ali <mr.rizvan.ali@gmail.com>"
# RFC 2822 date for the debian/changelog entry; also becomes SOURCE_DATE_EPOCH.
CHANGELOG_DATE="Thu, 22 Oct 2026 15:00:00 +0000"
CHANGELOG_TEXT="SECURITY UPDATE: Avoid state corruption via bailout (CVE-2026-109618, CVE-2026-109619). Backport of php-src 712e60f (PHP 7.4 minimal mitigation)."
